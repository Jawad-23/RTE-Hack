# Copy to .env (never commit .env). On Streamlit Cloud, put the same lines in the app's Settings -> Secrets.

# Option A: free open models through OpenRouter (https://openrouter.ai/keys)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
LLM_API_KEY=

# Option B: Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Option C: a local open model with Ollama (ollama pull qwen2.5:7b-instruct)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_BASE_URL=http://localhost:11434/v1
