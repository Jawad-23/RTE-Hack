# Copy to .env (never commit .env).

# Option A: Claude (default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Option B: an open-source model through any OpenAI-compatible server.
# Local Ollama:   ollama pull qwen2.5:7b-instruct   (then leave BASE_URL as below)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=            # only for hosted servers (Groq, OpenRouter, ...)
